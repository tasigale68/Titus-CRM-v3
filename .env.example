# ═══════════════════════════════════════════════════════════
# Titus CRM v3 — Environment Variables
# ═══════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════
# DATABASES
# ═══════════════════════════════════════════════════════════

# Titus CRM V5 (mptaztzpzvvaebdaqodt) — NDIS CRM app
V5_SUPABASE_URL=https://mptaztzpzvvaebdaqodt.supabase.co
V5_SUPABASE_SERVICE_KEY=your-v5-service-key

# Ask Yr Grandpa (khcyrpophlxxpprsjhio) — lead/assessment data
AYG_SUPABASE_URL=https://khcyrpophlxxpprsjhio.supabase.co
AYG_SUPABASE_SERVICE_KEY=your-ayg-service-key

# Legacy Supabase (for migrations, backwards compat)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Database mode — 'supabase' (default) or 'airtable' (legacy)
DATABASE=supabase

# Airtable (DEPRECATED — only needed if DATABASE=airtable)
# AIRTABLE_API_KEY=
# AIRTABLE_BASE_ID=appg3Cz7mEsGA6IOI

# ═══════════════════════════════════════════════════════════
# COMMUNICATION
# ═══════════════════════════════════════════════════════════

# Twilio (calls, SMS, WebRTC)
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+61488810958
TWILIO_FROM_NUMBER=+61468071489
GUS_PHONE=+61413538474
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_TWIML_APP_SID=

# Resend (email sending)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM=a4@askyrgrandpa.com

# ElevenLabs (AI voice agent "Denise")
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Anthropic Claude API
ANTHROPIC_API_KEY=

# Microsoft Graph (email)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_EMAIL_ADDRESS=

# Server
PORT=3000
NODE_ENV=development
